<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ 第 1 屏：欢迎 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="32dp"
            android:paddingRight="32dp">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/ic_doubao"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="肥鱼老师"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1A1C1F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="拍一道题，我陪你一步步想明白"
                android:textSize="15sp"
                android:textColor="#6B7280" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:text="板书分步讲解 · 公式排版 · 当堂小测\n语文英语的字词句 · 古诗文 · 背诵自测\n可自定义后端和提示词"
                android:textSize="13sp"
                android:textColor="#9AA0A6" />

            <TextView
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:text="开始"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_send" />
        </LinearLayout>

        <!-- ============ 第 2 屏：模型 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="先连上你的模型"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1C1F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="填一个 OpenAI 兼容的接口就行。Key 只存在本机。"
                android:textSize="13sp"
                android:textColor="#9AA0A6" />

            <TextView
                style="@style/FieldLabel"
                android:text="接口地址（baseURL）" />

            <EditText
                android:id="@+id/etOBase"
                style="@style/Inp"
                android:hint="https://api.deepseek.com"
                android:inputType="textUri" />

            <TextView
                style="@style/FieldLabel"
                android:text="API Key" />

            <EditText
                android:id="@+id/etOKey"
                style="@style/Inp"
                android:hint="sk-..."
                android:inputType="text" />

            <TextView
                style="@style/FieldLabel"
                android:text="模型" />

            <EditText
                android:id="@+id/etOModel"
                style="@style/Inp"
                android:hint="deepseek-flash"
                android:inputType="text" />

            <TextView
                android:id="@+id/btnOPing"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="测试连接"
                android:textSize="14sp"
                android:textColor="#2F6BFF"
                android:background="@drawable/bg_chip" />

            <TextView
                android:id="@+id/tvOPing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12.5sp"
                android:textColor="#6B7280" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text=""
                android:textSize="1sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="没有 Key 也能先进去，之后在设置里补填。Key 也可写在 /sdcard/Download/Operit/doubao/api.txt，重启生效。"
                android:textSize="12sp"
                android:textColor="#B0B6BF" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="下一步"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_send" />
        </LinearLayout>

        <!-- ============ 第 3 屏：模式 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选一种讲法"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1C1F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="之后随时能在设置里换。"
                android:textSize="13sp"
                android:textColor="#9AA0A6" />

            <RadioGroup
                android:id="@+id/rgOMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbOGuide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="引导式　只问不答，让他自己想出来"
                    android:textSize="15sp"
                    android:textColor="#1A1C1F" />

                <RadioButton
                    android:id="@+id/rbOTeach"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="讲解式　一步步讲清楚，适合补基础"
                    android:textSize="15sp"
                    android:textColor="#1A1C1F" />

                <RadioButton
                    android:id="@+id/rbOAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="直答式　先给答案再解析，赶时间用"
                    android:textSize="15sp"
                    android:textColor="#1A1C1F" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text=""
                android:textSize="1sp" />

            <TextView
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="开始用"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_send" />
        </LinearLayout>
    </ViewFlipper>

    <TextView
        android:id="@+id/tvStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="14dp"
        android:text="1 / 3"
        android:textSize="12sp"
        android:textColor="#C4C9D1" />
</LinearLayout>